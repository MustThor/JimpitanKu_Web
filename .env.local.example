# Environment Variables Template for JimpitanKu
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local or any .env files to version control

# ============================================
# SUPABASE CONFIGURATION
# ============================================
# Get these values from your Supabase project dashboard
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# APP CONFIGURATION
# ============================================
NEXT_PUBLIC_APP_NAME=JimpitanKu
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# ENVIRONMENT-SPECIFIC NOTES
# ============================================
# 
# DEVELOPMENT (.env.local):
# - Use your development Supabase project
# - NODE_ENV=development
# - NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# STAGING (.env.staging):
# - Use your staging Supabase project
# - NODE_ENV=staging
# - NEXT_PUBLIC_APP_URL=https://staging.your-domain.com
#
# PRODUCTION (.env.production):
# - Use your production Supabase project
# - NODE_ENV=production
# - NEXT_PUBLIC_APP_URL=https://your-production-domain.com
#
# TESTING (.env.test):
# - Use your test Supabase project
# - NODE_ENV=test
# - NEXT_PUBLIC_APP_URL=http://localhost:3000
#
